# Copy this file to ".env" and fill in real values. ".env" is git-ignored, so keys never get committed.

# Matches the credentials in docker-compose.yml
DATABASE_URL=postgresql+psycopg://jobmatch:jobmatch@localhost:5432/jobmatch

# AI model provider. "ollama" = free local models (install from ollama.com, then: ollama pull qwen2.5:7b)
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# For Claude (coming later): https://platform.claude.com/
ANTHROPIC_API_KEY=
